{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A storytelling campaign/project with customized setting, style, and rules.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "setting": { "type": "string" },
        "creatorNames": { "type": "string" },
        "customInstructions": { "type": "string" },
        "narrationStyle": { "type": "string" },
        "pacing": { "type": "string" },
        "emotionalTone": { "type": "string" },
        "canonSource": { "type": "string" },
        "styleGuide": { "type": "string" },
        "storyModules": { "type": "string" },
        "userNickname": { "type": "string" },
        "activeChatId": { "type": "string" },
        "ragSummary": { "type": "string" },
        "themeId": { "type": "string" }
      },
      "required": ["id", "name", "setting"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual chat message in a project thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "nyx", "assistant"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "projectId": { "type": "string" }
      },
      "required": ["id", "role", "content", "timestamp"]
    },
    "PromptVaultItem": {
      "title": "PromptVaultItem",
      "description": "An item in the prompt vault used to store character, lore, or scenario prompts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "characterName": { "type": "string" },
        "folder": { "type": "string" },
        "title": { "type": "string" },
        "promptText": { "type": "string" }
      },
      "required": ["id", "title", "promptText"]
    },
    "CharacterProfile": {
      "title": "CharacterProfile",
      "description": "A character profile belonging to a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "portraitUrl": { "type": "string" },
        "projectId": { "type": "string" }
      },
      "required": ["id", "name", "projectId"]
    },
    "KeepNote": {
      "title": "KeepNote",
      "description": "A personal scratchpad note.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content"]
    },
    "KeepTask": {
      "title": "KeepTask",
      "description": "A personal checklist/task item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "completed": { "type": "boolean" }
      },
      "required": ["id", "text", "completed"]
    },
    "GeneratedImage": {
      "title": "GeneratedImage",
      "description": "An image generated by AI inside the project gallery.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "prompt": { "type": "string" },
        "seed": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "projectId": { "type": "string" }
      },
      "required": ["id", "url", "prompt", "projectId"]
    }
  },
  "firestore": {
    "users/{userId}/projects": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Collection of projects created by a user."
    },
    "users/{userId}/projects/{projectId}/messages": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Subcollection of chat messages for a specific project."
    },
    "users/{userId}/projects/{projectId}/prompts": {
      "schema": { "$ref": "#/entities/PromptVaultItem" },
      "description": "Subcollection of prompts saved in the vault for a project."
    },
    "users/{userId}/projects/{projectId}/characters": {
      "schema": { "$ref": "#/entities/CharacterProfile" },
      "description": "Subcollection of custom characters for a project."
    },
    "users/{userId}/notes": {
      "schema": { "$ref": "#/entities/KeepNote" },
      "description": "Collection of keep notes created by a user."
    },
    "users/{userId}/tasks": {
      "schema": { "$ref": "#/entities/KeepTask" },
      "description": "Collection of keep tasks created by a user."
    },
    "users/{userId}/gallery": {
      "schema": { "$ref": "#/entities/GeneratedImage" },
      "description": "Collection of AI generated gallery images created by a user."
    }
  }
}
